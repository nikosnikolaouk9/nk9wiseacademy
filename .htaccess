# Προστασία των ευαίσθητων αρχείων δεδομένων και ρυθμίσεων
<FilesMatch "^(leads\.csv|admin-config\.json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Επιτρέπεται η απευθείας ανάγνωση του content.json από τον browser για τη δυναμική φόρτωση του site
<Files "content.json">
    Order Allow,Deny
    Allow from all
</Files>

# Δυναμική ανακατεύθυνση sitemap.xml -> sitemap.php (εφόσον υποστηρίζεται mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
